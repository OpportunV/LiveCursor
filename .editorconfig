root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,asmdef,asmref,uxml,uss}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.cs]
max_line_length = 120

# ── Layout ──────────────────────────────────────────────────────────────────────────────────
# Allman everywhere.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after

csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ── File and namespace shape ────────────────────────────────────────────────────────────────
# usings outside the namespace, above it.
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Block-scoped namespaces.
csharp_style_namespace_declarations = block_scoped:error


# ── Braces and explicitness ─────────────────────────────────────────────────────────────────
# Braces always, including single-statement bodies.
csharp_prefer_braces = true:error

# Block bodies for methods; expression bodies are fine for trivial properties.
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent

# Target-typed `new()` where the declared type already names it; `var` keeps the explicit form.
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent

csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

dotnet_style_readonly_field = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# ── Naming ──────────────────────────────────────────────────────────────────────────────────
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.i_pascal.capitalization = pascal_case
dotnet_naming_style.i_pascal.required_prefix = I

dotnet_naming_symbols.types.applicable_kinds = class,struct,enum,delegate
dotnet_naming_rule.types_are_pascal.symbols = types
dotnet_naming_rule.types_are_pascal.style = pascal
dotnet_naming_rule.types_are_pascal.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,field
dotnet_naming_symbols.public_members.applicable_accessibilities = public,protected,internal
dotnet_naming_rule.public_members_are_pascal.symbols = public_members
dotnet_naming_rule.public_members_are_pascal.style = pascal
dotnet_naming_rule.public_members_are_pascal.severity = warning

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_have_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_have_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_have_underscore.severity = warning

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter,local
dotnet_naming_rule.locals_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel.style = camel
dotnet_naming_rule.locals_are_camel.severity = warning

# Custom
dotnet_diagnostic.SA1201.severity = none
dotnet_diagnostic.SA1203.severity = none
dotnet_diagnostic.SA1214.severity = none
dotnet_diagnostic.SA1600.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1518.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1629.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1407.severity = none
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1134.severity = none
dotnet_diagnostic.SA1118.severity = none
dotnet_diagnostic.SA1408.severity = none
resharper_template_is_not_compile_time_constant_problem_highlighting = none
dotnet_style_require_accessibility_modifiers = always:error

# ── Generated and vendored code ─────────────────────────────────────────────────────────────

[Assets/Packages/**.cs]
generated_code = true
[**/*.Designer.cs]
generated_code = true

