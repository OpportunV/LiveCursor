.root {
    flex-grow: 1;
    padding: 32px 40px;
    background-color: rgb(44, 52, 70);
}

.title {
    font-size: 36px;
    -unity-font-style: bold;
    color: rgb(250, 250, 255);
}

.subtitle {
    margin-bottom: 20px;
    font-size: 16px;
    color: rgb(185, 195, 215);
    white-space: normal;
}

.cards {
    flex-direction: row;
    flex-wrap: wrap;
}

.card {
    width: 210px;
    height: 130px;
    margin: 0 14px 14px 0;
    padding: 14px 16px;
    border-radius: 10px;
    background-color: rgb(64, 76, 100);
    border-width: 2px;
    border-color: rgb(84, 98, 128);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.card:hover {
    background-color: rgb(78, 92, 122);
    border-color: rgb(255, 196, 64);
    scale: 1.03 1.03;
}

.card:active {
    scale: 0.98 0.98;
}

.card--disabled {
    opacity: 0.55;
}

.card--disabled:hover {
    border-color: rgb(232, 64, 64);
    scale: 1 1;
}

.card-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(250, 250, 255);
}

.card-text {
    margin-top: 6px;
    font-size: 14px;
    color: rgb(185, 195, 215);
    white-space: normal;
}

.text-field {
    margin: 10px 0 0 0;
}

.section {
    margin-top: 18px;
    margin-bottom: 8px;
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(250, 250, 255);
}

.row {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip {
    height: 36px;
    margin: 0 10px 10px 0;
    padding: 0 16px;
    font-size: 15px;
    border-radius: 18px;
    border-width: 0;
    color: rgb(30, 30, 40);
    background-color: rgb(235, 238, 245);
}

.chip:hover {
    background-color: rgb(255, 214, 120);
}

.chip--selected {
    background-color: rgb(255, 196, 64);
}

.status {
    margin-top: 18px;
    font-size: 14px;
    color: rgb(185, 195, 215);
    white-space: normal;
}
